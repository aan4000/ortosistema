# Cadena de conexión de Neon (incluye sslmode=require)
DATABASE_URL=postgresql://usuario:clave@host/neondb?sslmode=require
# Texto largo y aleatorio. Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=cambia-esto
JWT_HORAS=8
# Orígenes permitidos para el front-end, separados por coma (vacío = solo el mismo dominio)
CORS_ORIGINS=
# 1 = crea las tablas que falten al arrancar
AUTO_SCHEMA=1
